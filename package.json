        "cmdk": "^1.1.1",
        "embla-carousel-react": "^8.6.0",
        "input-otp": "^1.4.2",
        "next-themes": "^0.4.6",
        "radix-ui": "^1.6.2",
        "react": "^19.0.0",
        "react-day-picker": "^9.14.0",
        "react-dom": "^19.0.0",
        "react-resizable-panels": "^4.12.2",
        "recharts": "^3.9.2",
        "sonner": "^2.0.7",
        "tailwind-merge": "^3.6.0",
        "tw-animate-css": "^1.4.0",
        "vaul": "^1.1.2"
    },
    "devDependencies": {
        "@base-ui/react": "^1.8.0",
        "@solar-icons/react": "^2.2.0",
        "@tailwindcss/vite": "~4.3.3",
