{
    "name": "@shiron/ui",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "scripts": {
        "format": "oxfmt src demo/src demo/vite.config.ts demo/.storybook demo/scripts",
        "format:check": "oxfmt --check src demo/src demo/vite.config.ts demo/.storybook demo/scripts",
        "lint": "oxlint src demo/src demo/vite.config.ts demo/.storybook demo/scripts",
        "lint:fix": "oxlint --fix src demo/src demo/vite.config.ts demo/.storybook demo/scripts",
        "test": "vitest run --project unit",
        "test:watch": "vitest --project unit",
        "test:ui": "vitest --ui",
        "test:browser": "vitest run --project css",
        "test:all": "vitest run",
        "coverage": "vitest run --project unit --coverage",
        "demo:dev": "pnpm -C demo dev",
        "demo:build": "pnpm -C demo build",
        "check": "pnpm run format:check && pnpm run lint"
    },
    "exports": {
        "./*": "./src/*",
        "./styles/globals.css": "./src/styles/globals.css",
        "./lib/utils": "./src/lib/utils.ts",
        "./lib/themes": "./src/lib/themes.ts",
        "./hooks/use-mobile": "./src/hooks/use-mobile.ts",
        "./hooks/use-theme": "./src/hooks/use-theme.ts"
    },
    "files": [
        "src"
    ],
    "peerDependencies": {
        "@base-ui/react": "^1.6.0",
        "@solar-icons/react": "^2.0.0-beta.2",
        "class-variance-authority": "^0.7.1",
